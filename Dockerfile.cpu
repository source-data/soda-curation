# Use a CPU-only Python image as the base image
FROM python:3.12-slim-bookworm AS base

# Set work directory
WORKDIR /app

# Define deployment environment ARG early (before ENV declarations)
ARG DEPLOYMENT_ENV=dev
# Optional: GitHub Actions passes this for private git deps. Local builds omit it.
ARG GIT_ACCESS_TOKEN=

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_DEFAULT_TIMEOUT=100 \
    POETRY_VERSION=2.1.3 \
    POETRY_HOME="/opt/poetry" \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1 \
    PYSETUP_PATH="/app" \
    VENV_PATH="/app/.venv" \
    PATH="/app/.venv/bin:$PATH"

# Set deployment environment from the ARG value
ENV DEPLOYMENT_ENV=${DEPLOYMENT_ENV} \
    CONFIG_DIR=/app/config

# Install system dependencies INCLUDING ImageMagick in ONE step
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    cmake \
    libclang-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    git \
    ghostscript \
    poppler-utils \
    libgomp1 \
    imagemagick \
    && convert --version \
    && which convert \
    && rm -rf /var/lib/apt/lists/*

# Configure authenticated GitHub access only when a build token is provided (e.g. CI).
RUN if [ -n "${GIT_ACCESS_TOKEN}" ]; then \
      git config --global url."https://${GIT_ACCESS_TOKEN}@github.com/".insteadOf "https://github.com/"; \
    fi

# Update ImageMagick policy to allow EPS, PDF, and PostScript conversions.
# Required by the wand-based image conversion in mmqc_utils (EPS/PDF rasterization).
RUN for policy in /etc/ImageMagick-6/policy.xml /etc/ImageMagick-7/policy.xml; do \
    if [ -f "$policy" ]; then \
    sed -i 's/rights="none" pattern="EPS"/rights="read|write" pattern="EPS"/' "$policy"; \
    sed -i 's/rights="none" pattern="PDF"/rights="read|write" pattern="PDF"/' "$policy"; \
    sed -i 's/rights="none" pattern="PS"/rights="read|write" pattern="PS"/' "$policy"; \
    grep -iE 'EPS|PDF|"PS"' "$policy"; \
    echo "ImageMagick policy updated successfully: $policy"; \
    fi; \
    done

ENV LIBCLANG_PATH=/usr/lib/llvm-11/lib/

# Install Rust and Cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 - --version ${POETRY_VERSION}

# Add Poetry to PATH
ENV PATH="$POETRY_HOME/bin:$VENV_PATH/bin:$PATH"

# Copy project files
COPY pyproject.toml poetry.lock* ./
COPY src ./src
COPY ./data/models/panel_detection_model_no_labels.pt /app/data/models/

# Install dependencies and the package
RUN poetry install --no-interaction --no-ansi --no-root

# Install PyTorch for ARM/CPU (versions with Python 3.12 wheels)
RUN poetry run pip install --no-cache-dir \
    torch==2.6.0 \
    torchvision==0.21.0 \
    --extra-index-url https://download.pytorch.org/whl/cpu

# Set environment variables to manage threading and memory
ENV OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    GOMP_STACKSIZE_MAX=32768 
    # LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1

# Install additional packages
RUN poetry run pip install --upgrade pip \
    && poetry run pip install huggingface-hub \
    && poetry run pip install -q git+https://github.com/THU-MIG/yolov10.git \
    && poetry run pip install jupyterlab \
    && (git config --global --remove-section url 2>/dev/null || true)

# Create config directory 
RUN mkdir -p /app/config

# Copy the environment-specific config file
COPY config.${DEPLOYMENT_ENV}.yaml /app/config.yaml
COPY config.qc.yaml /app/config.qc.yaml
COPY config/ /app/config/

# Set PYTHONPATH
ENV PYTHONPATH=/app/src

# Verify key package installations (including ImageMagick)
RUN convert --version
RUN poetry run python -c "import yaml; print(yaml.__file__)"
RUN poetry run python -c "import openai; print(openai.__file__)"
# Fail the image build if panel-detection weights cannot be loaded (same path as runtime).
RUN poetry run python -c "from soda_curation.pipeline.match_caption_panel.object_detection import create_object_detection; create_object_detection({'object_detection': {'model_path': 'data/models/panel_detection_model_no_labels.pt'}}); print('YOLO panel detection weights loaded OK')"
RUN poetry run python -c "import mmqc_utils; print(mmqc_utils.__file__)"
RUN poetry run python -c "import torch; print(f'PyTorch version: {torch.__version__}'); print(f'CUDA available: {torch.cuda.is_available()}')"

# Copy environment files (they will be selected at runtime)
COPY .env* /app/

# Development stage
FROM base AS development
# No need to duplicate configuration here since it's already in base

# Formatting and linting stage
FROM base AS formatting

# Install development dependencies (including formatting tools)
RUN poetry install --with dev

# Copy the formatting script and flake8 config
COPY format_and_lint.sh /app/format_and_lint.sh
COPY .flake8 /app/.flake8
RUN chmod +x /app/format_and_lint.sh

# Set the entrypoint to the formatting script
ENTRYPOINT ["/app/format_and_lint.sh"]

# Testing stage
FROM base AS testing

# Copy test files
COPY tests ./tests

# Install test dependencies
RUN poetry install --with dev

# Run tests
CMD ["poetry", "run", "pytest", "-v", "--cov=soda_curation", "--cov-report=term-missing"]