# .env.example
OPENAI_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-key-here
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
# Keys for the Langfuse project named AIP-guidelines (not the QC project).
LANGFUSE_ACCEPTANCE_PUBLIC_KEY=your-acceptance-langfuse-public-key
LANGFUSE_ACCEPTANCE_SECRET_KEY=your-acceptance-langfuse-secret-key
# Optional. Falls back to LANGFUSE_HOST when unset.
# LANGFUSE_ACCEPTANCE_HOST=https://cloud.langfuse.com
ENVIRONMENT=test  # or dev or prod
MODEL_PROVIDER=openai
